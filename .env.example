# VITE_WHATSAPP_NUMBER: número de WhatsApp para el CTA de contacto, formato internacional sin "+" ni espacios (ej. 569XXXXXXXX).
# Opcional: si queda vacío se usa el número público por defecto definido en src/config/contact.ts.
VITE_WHATSAPP_NUMBER=""

# --- Formulario de contacto (Worker /api/contact → Airtable). Ver .docs/001-formulario-contacto.md ---
# Pública (build del frontend): site key del widget Cloudflare Turnstile.
VITE_TURNSTILE_SITE_KEY=""
# Secrets del Worker (cargar con `npx wrangler secret put NOMBRE` o en el dashboard; NUNCA en el repo).
# Para desarrollo local con `wrangler dev`, copiar a .dev.vars (ignorado por git).
AIRTABLE_TOKEN=""          # Personal access token con scope data.records:write solo sobre la base CRM Leads
TURNSTILE_SECRET_KEY=""    # Secret key del widget Turnstile
# No secretas (definidas en wrangler.jsonc > vars):
# AIRTABLE_BASE_ID=appP7fO5tHH0hmYal
# AIRTABLE_TABLE_ID=tblcCzdpPS1DHa7m8
