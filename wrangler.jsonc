{
  // Configuración del Worker que publica www.arlandstack.com (Workers Builds).
  // Ver .docs/004-despliegue.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arland-michelena-digital",
  "compatibility_date": "2026-10-01",
  // Worker para /api/* (formulario de contacto). El resto lo sirven los assets.
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Variables NO secretas (los IDs de Airtable no dan acceso sin token).
  // Secrets AIRTABLE_TOKEN y TURNSTILE_SECRET_KEY: `wrangler secret put` o dashboard, nunca aquí.
  "vars": {
    "AIRTABLE_BASE_ID": "appH6NWzsko5eLlyu",
    "AIRTABLE_TABLE_ID": "tblY7Lm88XH1YqdM7"
  },
  "observability": { "enabled": true }
}
